# Copy to .env. Replace the three empty secrets before running Compose.
# Generate each value locally with: openssl rand -hex 32
POSTGRES_USER=nightstudy
POSTGRES_DB=nightstudy
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
BOOTSTRAP_TOKEN=

PUBLIC_URL=http://127.0.0.1:5198
NIGHTSTUDY_HTTP_PORT=5198
COMPOSE_PROJECT_NAME=nightstudy
REGISTRATION_OPEN=true
# Native development. Compose/Render explicitly override this to 0.0.0.0:3000.
HOST=127.0.0.1
PORT=5198
TRUST_PROXY_CIDRS=
# Default for native/Compose. render-public is only for Render public web ingress.
CLIENT_IP_PROFILE=socket
# For native development, set a real local PG URL. Compose uses its internal PG by default.
DATABASE_URL=
# Optional operator-owned private JSON mounted under /run/nightstudy/sites/.
SITES_FILE=
BASE_PATH=
DB_POOL_SIZE=5
MAX_ACTIVE_SITES=20
# Default initial installation downloads verified complete ECDICT and US/UK phonetics.
# demo is an explicit small profile for automated tests or a minimal evaluation.
CONTENT_PACK=ecdict
# Empty selects standard for ecdict and none for the explicit demo profile.
# standard installs pinned prebuilt US/UK word and sentence packs.
# Recorded pronunciations take priority; missing audio is generated offline before release.
# none skips this content download for automated tests or a minimal installation.
AUDIO_PACK=
AUDIO_CACHE_DIR=.local/audio
# Python is used only for archive validation/extraction; runtime never generates speech.
# Docker uses its bundled python3. Offline authoring uses a separate tool environment.
AUDIO_PYTHON=

# Optional deployment-only private AI proxy allowlist. No private endpoint is trusted by default.
# Exact origins + fixed IP addresses; never paste API keys here.
AI_PRIVATE_ENDPOINTS_JSON=[]

# Default init creates username admin and a unique random password once per site.
# scripts/install.sh also saves the private credentials on the VPS host.
# manual retains the optional BOOTSTRAP_TOKEN setup page; existing admins are never reset.
ADMIN_BOOTSTRAP=auto
ADMIN_CREDENTIALS_DIR=.local/admin
# Optional single-site overrides (e.g. a platform-generated persistent environment secret).
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=

# Optional scale profile. Change the subnet if it conflicts with an existing network.
NIGHTSTUDY_SCALE_SUBNET=172.31.27.0/24
# Empty uses the local image built from this checkout.
NIGHTSTUDY_IMAGE=

# Google web compatibility interface is unofficial and best-effort.
# Default only opens Google's official website. Production integrated mode uses gateway.
TRANSLATION_MODE=website-official
TRANSLATION_GATEWAY_URL=
TRANSLATION_GATEWAY_SECRET=
TRANSLATION_REQUESTS_PER_MINUTE=120
