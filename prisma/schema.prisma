generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                  @id
  name               String
  email              String                  @unique
  username           String?                 @unique
  displayUsername    String?
  emailVerified      Boolean                 @default(false)
  image              String?
  role               String                  @default("user")
  disabled           Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  accounts           Account[]
  settings           UserSettings?
  words              UserWord[]
  progress           StudyProgress[]
  studySessions      StudySession[]
  receipts           CommandReceipt[]
  reviews            ReviewLog[]
  imports            KnownImport[]
  claims             KnownClaim[]
  assessments        Assessment[]
  mastery            MasteryProfile[]
  activity           ActivityInterval[]
  customBooks        Book[]
  bookImports        CustomBookImport[]
  dailyPlans         DailyPlan[]
  autoKnownWords     AutoKnownWord[]
  learningPreference UserLearningPreference?
  librarySentences   LibrarySentence[]
  libraryNotes       LibraryNote[]
  academyAttempts    AcademyAttempt[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model SiteState {
  id                       String    @id @default("singleton")
  siteId                   String
  instanceId               String    @default(dbgenerated("gen_random_uuid()::text"))
  registrationOpenOverride Boolean?
  initialized              Boolean   @default(false)
  initializedAt            DateTime?
  contentVersion           String    @default("demo-2026-10-14")
}

// One public, re-encoded wallpaper per isolated site database. No remote URLs.
model SiteAppearance {
  id               String   @id @default("singleton")
  mode             String   @default("rain-night")
  positionX        Float    @default(50)
  positionY        Float    @default(50)
  overlay          Float    @default(0.4)
  animationEnabled Boolean  @default(true)
  revision         Int      @default(0)
  imageSha256      String?
  imageBytes       Bytes?
  updatedAt        DateTime @updatedAt
}

// Public, prebuilt sentence audio only. Runtime never synthesizes arbitrary input.
model SentenceAudio {
  id          String   @id
  textHash    String
  text        String
  accent      String
  kind        String
  status      String   @default("ready")
  sourceName  String
  sourceUrl   String
  license     String
  attribution String
  fileKey     String
  fileSha256  String
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([textHash, accent])
  @@index([status, accent])
}

model FleetPairingToken {
  id          String    @id @default(cuid())
  label       String
  tokenHash   String    @unique
  scopes      String[]
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
}

model FleetGrant {
  id                   String    @id @default(cuid())
  label                String
  credentialHash       String    @unique
  controllerInstanceId String
  controllerSiteId     String
  controllerUrl        String
  scopes               String[]
  createdById          String
  revokedAt            DateTime?
  lastUsedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@index([revokedAt])
}

model FleetConnection {
  id                   String    @id @default(cuid())
  label                String
  remoteUrl            String    @unique
  remoteInstanceId     String
  remoteSiteId         String
  grantId              String
  credentialCiphertext String
  scopes               String[]
  status               String    @default("active")
  lastSnapshot         Json?
  lastCheckedAt        DateTime?
  lastErrorCode        String?
  createdById          String
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
}

model SystemUpdateCheck {
  id              String    @id @default("singleton")
  status          String    @default("unchecked")
  payloadJson     Json?
  checkedAt       DateTime?
  lastAttemptedAt DateTime?
  lockedUntil     DateTime?
  lockId          String?
  updatedAt       DateTime  @updatedAt
}

model ContentPack {
  id                String   @id
  version           String
  status            String   @default("ready")
  sourceUrl         String
  sha256            String
  license           String
  entryCount        Int
  phoneticCount     Int
  definitionZhCount Int
  definitionEnCount Int
  tagCounts         Json
  installedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model UserSettings {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                String    @default("daily")
  currentBookId       String?
  dailyNewLimit       Int       @default(20)
  dailyTotalGoal      Int       @default(20)
  groupSize           Int       @default(5)
  timeZone            String    @default("Asia/Shanghai")
  pendingTimeZone     String?
  timeZoneEffectiveAt DateTime?
  revision            Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

model Word {
  id               String            @id
  lemma            String
  normalizedLemma  String            @unique
  phonetic         String            @default("")
  phoneticUs       String            @default("")
  phoneticUk       String            @default("")
  phoneticSource   String            @default("")
  goalTags         String[]
  difficulty       Int               @default(1)
  status           String            @default("published")
  sourceRef        String            @default("NightStudy original demo")
  contentVersion   String            @default("demo-2026-10-14")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  senses           Sense[]
  learningSenses   LearningSense[]
  examples         WordExample[]
  bookItems        BookItem[]
  userWords        UserWord[]
  progress         StudyProgress[]
  sessionItems     SessionItem[]
  reviews          ReviewLog[]
  claims           KnownClaim[]
  assessmentItems  AssessmentItem[]
  audio            WordAudio[]
  dailyPlanWords   DailyPlanWord[]
  autoKnownWords   AutoKnownWord[]
  collocations     WordCollocation[] @relation("CollocationHeadword")
  collocationOf    WordCollocation[] @relation("CollocationPhrase")
  librarySentences LibrarySentence[]
  libraryNotes     LibraryNote[]

  @@index([status, difficulty])
}

model Sense {
  id              String @id
  wordId          String
  word            Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  pos             String
  definitionZh    String
  definitionEn    String @default("")
  exampleEn       String @default("")
  exampleZh       String @default("")
  ordinal         Int    @default(0)
  contentMetadata Json   @default("{}")
  learningBindings SenseSourceBinding[]

  @@unique([id, wordId])
  @@index([wordId, ordinal])
}

// Curated atomic meanings are distinct from immutable source dictionary rows.
model LearningSense {
  id              String @id
  wordId          String
  word            Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  pos             String
  definitionZh    String
  definitionEn    String
  ordinal         Int @default(0)
  status          String @default("candidate")
  contentVersion  String
  bindingHash     String
  contentMetadata Json @default("{}")
  sourceBindings  SenseSourceBinding[]
  examples        WordExample[]

  @@unique([id, wordId])
  @@unique([id, wordId, contentVersion])
  @@index([wordId, status, ordinal, id])
}

model SenseSourceBinding {
  id                       String @id
  wordId                   String
  learningSenseId          String
  learningSense            LearningSense @relation(fields: [learningSenseId, wordId], references: [id, wordId], onDelete: Restrict)
  sourceSenseId            String
  sourceSense              Sense @relation(fields: [sourceSenseId, wordId], references: [id, wordId], onDelete: Restrict)
  relation                 String
  sourcePosSha256          String
  sourceDefinitionZhSha256 String
  sourceDefinitionEnSha256 String
  contentMetadata          Json @default("{}")

  @@unique([learningSenseId, sourceSenseId])
  @@index([sourceSenseId, wordId])
}

// Unbound historical word-level usages remain candidates, never reused as a meaning's examples.
model WordExample {
  id              String @id
  wordId          String
  word            Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  exampleEn       String
  exampleZh       String
  contentMetadata Json   @default("{}")
  ordinal         Int    @default(0)
  learningSenseId String?
  learningSense   LearningSense? @relation(fields: [learningSenseId, wordId, contentVersion], references: [id, wordId, contentVersion], onDelete: Restrict, onUpdate: Restrict)
  contextLabel    String @default("")
  status          String @default("candidate")
  contentVersion  String @default("")

  @@index([wordId, ordinal])
  @@index([learningSenseId, status, ordinal, id])
}

model LookupRevision {
  scope    String @id
  revision BigInt @default(0)
}

model Book {
  id          String             @id
  slug        String             @unique
  title       String
  description String
  goal        String
  kind        String             @default("vocabulary")
  status      String             @default("published")
  version     String             @default("demo-2026-10-14")
  ownerId     String?
  owner       User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  imports     CustomBookImport[]
  items       BookItem[]
  sessions    StudySession[]
  updatedAt   DateTime           @updatedAt

  @@index([ownerId, status])
}

model WordCollocation {
  wordId   String
  word     Word   @relation("CollocationHeadword", fields: [wordId], references: [id], onDelete: Cascade)
  phraseId String
  phrase   Word   @relation("CollocationPhrase", fields: [phraseId], references: [id], onDelete: Cascade)
  ordinal  Int    @default(0)

  @@id([wordId, phraseId])
  @@index([phraseId])
}

model WordAudio {
  id          String   @id @default(cuid())
  wordId      String
  word        Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  accent      String
  kind        String
  status      String   @default("ready")
  sourceName  String
  sourceUrl   String
  license     String
  attribution String
  fileKey     String
  fileSha256  String
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([wordId, accent])
  @@index([status, accent])
}

model CustomBookImport {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId        String?
  book          Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
  title         String
  description   String    @default("")
  goal          String
  filename      String
  format        String
  formatVersion String    @default("word-lines-v1")
  sha256        String
  status        String    @default("preview")
  rowsJson      Json
  countsJson    Json
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  confirmedAt   DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model BookItem {
  id           String  @id @default(cuid())
  bookId       String
  book         Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  wordId       String
  word         Word    @relation(fields: [wordId], references: [id], onDelete: Restrict)
  focusSenseId String?
  ordinal      Int

  @@unique([bookId, wordId])
  @@unique([bookId, ordinal])
}

model UserWord {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId      String
  word        Word      @relation(fields: [wordId], references: [id], onDelete: Restrict)
  note        String    @default("")
  favorite    Boolean   @default(true)
  paused      Boolean   @default(false)
  graduatedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, wordId])
  @@index([userId, updatedAt, id])
}

// Learning-derived familiarity is separate from manual known-word imports.
model AutoKnownWord {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId        String
  word          Word      @relation(fields: [wordId], references: [id], onDelete: Restrict)
  confirmedAt   DateTime
  revokedAt     DateTime?
  policyVersion String    @default("fsrs-familiarity-v1")

  @@unique([userId, wordId])
  @@index([userId, revokedAt])
}

model StudyProgress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId           String
  word             Word      @relation(fields: [wordId], references: [id], onDelete: Restrict)
  fsrsJson         Json
  dueAt            DateTime
  lastReviewAt     DateTime?
  firstLearnedAt   DateTime?
  revision         Int       @default(0)
  reviewFocusSenseId String?
  reviewFocusRevision Int    @default(0)
  algorithmVersion String    @default("ts-fsrs-5.4.2")
  paramVersion     String    @default("retention-0.9-v1")
  updatedAt        DateTime  @updatedAt

  @@unique([userId, wordId])
  @@index([userId, dueAt])
}

model StudySession {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId        String?
  book          Book?         @relation(fields: [bookId], references: [id], onDelete: Restrict)
  mode          String
  planId        String?
  plan          DailyPlan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  taskKind      String        @default("legacy")
  pausedAt      DateTime?
  deferredUntil DateTime?
  status        String        @default("in_progress")
  phase         String        @default("recall")
  cursor        Int           @default(0)
  step          String        @default("prompt")
  revision      Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         SessionItem[]

  @@index([userId, status, mode])
}

model SessionItem {
  id               String       @id @default(cuid())
  sessionId        String
  session          StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  wordId           String
  word             Word         @relation(fields: [wordId], references: [id], onDelete: Restrict)
  focusSenseId     String?
  ordinal          Int
  contentSnapshot  Json
  questionJson     Json
  revealed         Boolean      @default(false)
  rated            Boolean      @default(false)
  exerciseDone     Boolean      @default(false)
  status           String       @default("pending")
  progressRevision Int          @default(0)

  @@unique([sessionId, wordId])
  @@unique([sessionId, ordinal])
}

model CommandReceipt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commandId    String
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, commandId])
}

model ReviewLog {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId               String
  word                 Word       @relation(fields: [wordId], references: [id], onDelete: Restrict)
  commandId            String
  rating               String
  reviewedAt           DateTime   @default(now())
  beforeState          Json
  afterState           Json
  retrievabilityBefore Float?
  wasNew               Boolean    @default(false)
  planId               String?
  plan                 DailyPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@unique([userId, commandId])
  @@index([userId, reviewedAt])
  @@index([planId, reviewedAt])
  @@index([userId, wordId, reviewedAt])
}

model DailyPlan {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDate       String
  timeZone        String
  startsAt        DateTime
  endsAt          DateTime
  targetTotal     Int
  sourceBookId    String?
  sourceBookTitle String?
  goal            String
  prefsRevision   Int
  revision        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  words           DailyPlanWord[]
  sessions        StudySession[]
  reviews         ReviewLog[]

  @@unique([userId, startsAt])
  @@index([userId, endsAt])
}

model DailyPlanWord {
  id              String    @id @default(cuid())
  planId          String
  plan            DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  wordId          String
  word            Word      @relation(fields: [wordId], references: [id], onDelete: Restrict)
  bucket          String
  status          String    @default("queued")
  dueAtSnapshot   DateTime?
  firstRatedAt    DateTime?
  activeSessionId String?
  deferredUntil   DateTime?
  ordinal         Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([planId, wordId])
  @@index([planId, status, ordinal])
}

model KnownImport {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        String       @default("preview")
  formatVersion String       @default("1")
  rowsJson      Json
  countsJson    Json
  confirmedAt   DateTime?
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  claims        KnownClaim[]

  @@index([userId, createdAt])
}

model KnownClaim {
  id        String      @id @default(cuid())
  importId  String
  import    KnownImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word        @relation(fields: [wordId], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now())

  @@unique([importId, wordId])
  @@index([userId, wordId])
}

model Assessment {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             String
  blueprintVersion String           @default("demo-baseline-v1")
  status           String           @default("in_progress")
  seed             String
  reportJson       Json?
  aiStatus         String           @default("not_requested")
  aiClaimId        String?
  aiStartedAt      DateTime?
  aiCompletedAt    DateTime?
  aiResultJson     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            AssessmentItem[]

  @@index([userId, createdAt])
}

model AssessmentItem {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  wordId       String
  word         Word       @relation(fields: [wordId], references: [id], onDelete: Restrict)
  type         String
  stratum      String
  ordinal      Int
  questionJson Json
  answerJson   Json?
  correct      Boolean?
  score        Float?
  answeredAt   DateTime?

  @@unique([assessmentId, ordinal])
}

model MasteryProfile {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           String
  profileVersion String   @default("demo-baseline-v1")
  evidenceJson   Json
  updatedAt      DateTime @updatedAt

  @@unique([userId, goal])
}

model ActivityInterval {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId          String
  startAt          DateTime
  endAt            DateTime
  validatedSeconds Int

  @@unique([userId, eventId])
  @@index([userId, startAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  status    String   @default("published")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  detail    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("pending")
  payload     Json
  result      Json?
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now())
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
}

model RateBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model DeepSeekSetting {
  id                String   @id @default("singleton")
  enabled           Boolean  @default(false)
  assessmentEnabled Boolean  @default(false)
  provider          String   @default("deepseek")
  baseUrl           String   @default("https://api.deepseek.com")
  protocol          String   @default("openai-chat")
  authMode          String   @default("bearer")
  model             String   @default("deepseek-flash")
  keyCiphertext     String?
  keyPreview        String?
  updatedAt         DateTime @updatedAt
}

model DeepSeekRequestLease {
  id        String   @id
  actorId   String
  siteId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model UserLearningPreference {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String   @default("day")
  accent          String   @default("us")
  autoPlay        Boolean  @default(false)
  spellingEnabled Boolean  @default(true)
  meaningChoiceEnabled Boolean @default(true)
  fontScale       Float    @default(1)
  reminderEnabled Boolean  @default(false)
  reminderTime    String   @default("20:00")
  revision        Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model LibrarySentence {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId     String?
  word       Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  sourceType String
  sourceId   String
  sourceHash String
  exampleEn  String
  exampleZh  String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@unique([userId, sourceType, sourceId, sourceHash])
  @@index([userId, createdAt, id])
}

model LibraryNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String?
  word      Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  title     String
  body      String
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt, id])
}

model AcademyAttempt {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lessonVersion String
  kind          String
  status        String    @default("in_progress")
  revision      Int       @default(0)
  itemsJson     Json      @default("[]")
  resultJson    Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId, startedAt, id])
}
